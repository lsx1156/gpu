#!/usr/bin/env bash
export DISPLAY=:0
export T0=$(date +%s)
exec >> /home/umeko/.kiosk-x.log 2>&1
echo "T0 kiosk_start: $T0"
echo "==== kiosk start $(date) ===="
for o in $(xrandr --query 2>/dev/null | awk '/ connected/ && !/^[[:space:]]/{print $1}'); do
  echo "rotate: $o"
  xrandr --output "$o" --rotate right || true
done
echo "--- xrandr after ---"
xrandr | grep -E " connected|*"
openbox &
echo "T_openbox_launched $(($(date +%s)-T0))s"
unclutter -idle 0 &
sleep 1
echo "等待 Grafana 就绪..."
until curl -sf -o /dev/null http://127.0.0.1:3000/api/health; do sleep 2; done
echo "T_grafana_ready $(($(date +%s)-T0))s"
echo "Grafana 就绪，启动浏览器"
echo "T_chromium_exec $(($(date +%s)-T0))s"
# 渲染终版（2026-08-31 ANGLE 专项结案）：
# - ANGLE gles 无沙箱 → msm_dri 22min 假成功循环（drm-engine=0，纯浪费）
# - ANGLE gles 有沙箱 → 快速失败；ANGLE gl → 任何情况快速失败
# - Chromium 151 Linux 仅 ANGLE 一个 GL 后端 → 硬件加速判死，显式钉死 SwiftShader
# - --disable-gpu-compositing 必须保留：DRM overlay 提交不到物理面板（黑屏）
# - 1.5x 缩放已移除（软渲染下渲染量 ×2.25，代价过高）
exec /usr/bin/chromium --kiosk --noerrdialogs --lang=zh-CN --disable-translate --disable-gpu-watchdog --disable-background-networking --disable-gpu-compositing --use-angle=swiftshader --user-data-dir=/home/umeko/.kiosk http://127.0.0.1:3000/d/netdata-system-zh?kiosk
